# Configuración de variables de entorno para Nubel Admin
#
# Dos archivos, uno por base de datos (ver docs/features/entornos.md):
#   .env.local      → PRODUCCIÓN  (npm run dev      → http://localhost:3002)
#   .env.dev.local  → DESARROLLO  (npm run dev:dev  → http://localhost:3003)
# Ambos están en .gitignore. Copia este archivo a cada uno y completa los valores.

# prod | dev — se muestra en la franja superior del portal
NEXT_PUBLIC_NUBEL_ENV=prod

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App principal: https://app.nubel.tech (prod) · https://nubelsaas-dev-gamma.vercel.app (dev)
MAIN_APP_URL=https://app.nubel.tech
NEXT_PUBLIC_MAIN_APP_URL=https://app.nubel.tech

# Solo en .env.dev.local: carpeta de build propia para correr junto a PROD
# NEXT_DIST_DIR=.next-dev
